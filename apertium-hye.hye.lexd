VerbRootCryLong(1) VZero VerbRootCryLong(2): ThE   # լացել
VerbRootBring(1) VZero VerbRootBring(2): ThE   # բերել
VerbRootBring(1) VZero VerbRootBring(2): ThE? # Dir/LR   to capture variation in theme-les
VerbRootSeeA(1) VZero VerbRootSeeA(2):     # տեսնել
VerbRootSeeA(1) VZero VerbRootSeeA(2): (EmptyNasal? ThE)? # Dir/LR   to capture variation in theme-less or infix-less
VerbRootSeeE(1) VZero VerbRootSeeE(2):    # տեսնալ
VerbRootSeeE(1) VZero VerbRootSeeE(2): (EmptyNasal? ThA)? # Dir/LR   to capture variation in theme-less or infix-less
VerbRootPutPres(1) VZero VerbRootPutPres(2): ThE   # դնել
VerbRootGoPastHye(1) VZero VerbRootGoPastHye(2): ThA   #  գնացնել
VerbRootHitStop(1) VZero VerbRootHitStop(2): ThE   # զարկել
VerbRootEatPast(1) VZero VerbRootEatPast(2):     # ուտել
VerbRootEatPres(1) VZero VerbRootEatPres(2):  ThE   # Dir/LR
VerbRootStandHyePastANoAff(1) VZero VerbRootStandHyePastANoAff(2):    
VerbRootStandHyePastENoAff(1) VZero VerbRootStandHyePastENoAff(2):     # Dir/LR
VerbRootRiseEPast(1) VZero VerbRootRiseEPast(2):    

#Base of passive is root
PATTERN PassBase
VerbStemE 
VerbStemA ThA Aor

CausBase CausPass 
#This is for orthographic variants
CausativeVerbRootOrthographicSchwa VZero  CausPass # [<caus_listed>:]
CausativeVerbRootOrthographicAffr VZero CausOrthographicAffrPass # [<caus_listed>:] 
CausativeVerbRootOrthographicAffrSchwa VZero  CausOrthographicAffrPass # [<caus_listed>:]


#This is for lexically listed passives
#Lexical passives take their own special valency tag. Might need to change this later if 
#it violates some tagging rule TO DO
PassiveVerbRoot VZero # [<pass_listed>:] 

#Should I care that this will rarely be traversed? TO DO
InchBase InchEmpty Aor 
InchBaseWashHye InchEmpty Aor # 

